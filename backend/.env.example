# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# SAM.gov API Keys (for public API)
SAM_API_KEY_1=your_sam_api_key_1_here
SAM_API_KEY_2=your_sam_api_key_2_here
SAM_API_KEY_3=your_sam_api_key_3_here

# SAM.gov Client API Session Tokens
CLIENT_API_SESSION=your_session_token_here
CLIENT_API_XSRF_TOKEN=your_xsrf_token_here
CLIENT_API_AUTH_TOKEN=your_auth_token_here
CLIENT_API_COOKIES=your_full_cookie_string_here

# Gemini API Key for AI Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (optional)
# Add allowed origins separated by commas
# CORS_ALLOWED_ORIGINS=http://192.168.1.100:4333,http://client-machine:4333

# VPN Configuration (optional)
# Set your VPN subnet for automatic CORS approval
# VPN_SUBNET=192.168.100.0/24